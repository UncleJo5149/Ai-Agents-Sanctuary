{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent-to-Agent (A2A) Utility Infrastructure Platform API",
    "version": "2.5.0",
    "description": "Production-grade execution APIs for Autonomous AI Agents, Swarms, and LLM Frameworks (ElizaOS, CrewAI, AutoGen, LangChain). Features Ephemeral MicroVM Code Sandboxes, Anti-Shield Web Scrapers, W3C DID Reputation Notary, and x402 Multi-Chain Crypto Micropayments.",
    "contact": {
      "name": "AI Agent Infrastructure Protocol",
      "url": "https://agentprotocol.ai",
      "email": "ops@agentprotocol.ai"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Deployment Host"
    }
  ],
  "tags": [
    { "name": "Tools", "description": "Execution sandboxes and anti-shield web scrapers" },
    { "name": "Identity & Notary", "description": "W3C DID verification, trust score calculation, and verifiable credential issuance" },
    { "name": "Settlement (x402)", "description": "HTTP 402 machine micropayments across Base USDC, TRON USDT, and Solana SOL" },
    { "name": "Model Context Protocol", "description": "Anthropic MCP JSON-RPC 2.0 endpoint" },
    { "name": "Discovery", "description": "Machine-readable standard discovery endpoints" }
  ],
  "paths": {
    "/api/v1/tools/sandbox": {
      "post": {
        "tags": ["Tools"],
        "summary": "Execute isolated code in Ephemeral MicroVM sandbox",
        "description": "Executes JavaScript or Python code within a restricted V8 or process container with configurable memory (max 512MB) and timeout limits (max 15s). Prohibits unsafe sys-calls and dangerous disk/network mutations.",
        "security": [
          { "BearerAuth": [] },
          { "OperatorKeyAuth": [] },
          { "X402Micropayment": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SandboxRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution result output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequiredResponse"
          }
        }
      }
    },
    "/api/v1/tools/scrape": {
      "post": {
        "tags": ["Tools"],
        "summary": "Anti-Shield Web Scraper & Markdown Extractor",
        "description": "Fetches target URL with stealth browser headers, removes navigation/ads/scripts, extracts metadata and tabular data, and converts output into clean LLM-optimized Markdown.",
        "security": [
          { "BearerAuth": [] },
          { "OperatorKeyAuth": [] },
          { "X402Micropayment": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScrapeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Clean markdown and extracted metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapeResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequiredResponse"
          }
        }
      }
    },
    "/api/v1/identity/verify": {
      "post": {
        "tags": ["Identity & Notary"],
        "summary": "Verify Agent DID and Calculate Reputation Score",
        "description": "Validates W3C Decentralized Identifiers (did:key, did:web, did:agent), checks cryptographic signatures, calculates an on-chain trust score (0-100), and outputs a tamper-evident Verifiable Credential.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result and trust breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityVerifyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pay/x402/quote": {
      "post": {
        "tags": ["Settlement (x402)"],
        "summary": "Generate HTTP 402 Micropayment Quote",
        "description": "Generates a deterministic invoice with unique payment nonce and verified receiving addresses for Base USDC, TRON USDT, and Solana SOL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/X402QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment quote invoice and multi-chain settlement rails",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402QuoteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pay/x402/verify": {
      "post": {
        "tags": ["Settlement (x402)"],
        "summary": "Verify Payment & Unlock Session Token",
        "description": "Submits an on-chain transaction hash or payment signature to unlock machine-to-machine session credits.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/X402VerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active session token and unlocked call quota",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402VerifyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": ["Model Context Protocol"],
        "summary": "Anthropic Model Context Protocol (MCP) JSON-RPC 2.0 Server",
        "description": "Standard JSON-RPC 2.0 endpoint supporting tools/list, tools/call, prompts/list, and resources/list.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpJsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC 2.0 response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpJsonRpcResponse"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/agent.json": {
      "get": {
        "tags": ["Discovery"],
        "summary": "A2A Protocol Discovery Manifest",
        "description": "Returns standard Agent-to-Agent discovery manifest with supported capabilities, MCP endpoints, and x402 payment rails.",
        "responses": {
          "200": {
            "description": "A2A Discovery JSON"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "m2m_token"
      },
      "OperatorKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Operator-Key"
      },
      "X402Micropayment": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Payment-Authorization"
      }
    },
    "responses": {
      "PaymentRequiredResponse": {
        "description": "HTTP 402 Payment Required - includes X-402 headers and settlement quote",
        "headers": {
          "X-402-Version": { "schema": { "type": "string", "example": "2.0" } },
          "X-Payment-Protocol": { "schema": { "type": "string", "example": "x402" } },
          "X-402-Invoice": { "schema": { "type": "string", "example": "inv_123456" } },
          "X-Payment-Amount": { "schema": { "type": "string", "example": "0.29" } },
          "X-Payment-Currency": { "schema": { "type": "string", "example": "USDC,USDT,SOL" } },
          "X-Payment-Address-Base": { "schema": { "type": "string" } },
          "X-Payment-Address-Tron": { "schema": { "type": "string" } },
          "X-Payment-Address-Solana": { "schema": { "type": "string" } }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Payment Required" },
                "status": { "type": "integer", "example": 402 },
                "quote": { "$ref": "#/components/schemas/X402QuoteResponse" }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "SandboxRequest": {
        "type": "object",
        "required": ["language", "code"],
        "properties": {
          "language": { "type": "string", "enum": ["javascript", "python", "typescript"] },
          "code": { "type": "string", "description": "Code string to execute" },
          "timeout_ms": { "type": "integer", "default": 5000, "maximum": 15000 },
          "memory_limit_mb": { "type": "integer", "default": 512, "maximum": 512 },
          "environment": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "SandboxResponse": {
        "type": "object",
        "properties": {
          "execution_id": { "type": "string" },
          "language": { "type": "string" },
          "status": { "type": "string", "enum": ["success", "error", "timeout", "memory_exceeded", "forbidden_syscall"] },
          "exit_code": { "type": "integer" },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "duration_ms": { "type": "integer" },
          "memory_used_kb": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "ScrapeRequest": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "extract_tables": { "type": "boolean", "default": true },
          "include_links": { "type": "boolean", "default": false },
          "max_length": { "type": "integer" },
          "user_agent_profile": { "type": "string", "enum": ["stealth_chrome", "bot_curl", "googlebot"] }
        }
      },
      "ScrapeResponse": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "markdown": { "type": "string" },
          "metadata": {
            "type": "object",
            "properties": {
              "word_count": { "type": "integer" },
              "estimated_read_minutes": { "type": "integer" },
              "status_code": { "type": "integer" }
            }
          },
          "tables": { "type": "array", "items": { "type": "object" } }
        }
      },
      "IdentityVerifyRequest": {
        "type": "object",
        "required": ["agent_did"],
        "properties": {
          "agent_did": { "type": "string", "example": "did:key:z6Mkt123..." },
          "agent_name": { "type": "string" },
          "model_family": { "type": "string" },
          "public_key_pem": { "type": "string" },
          "signature": { "type": "string" },
          "payload_signed": { "type": "string" },
          "transaction_count": { "type": "integer" }
        }
      },
      "IdentityVerifyResponse": {
        "type": "object",
        "properties": {
          "valid": { "type": "boolean" },
          "agent_did": { "type": "string" },
          "trust_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "trust_tier": { "type": "string" },
          "reputation": { "type": "object" },
          "verifiable_credential": { "type": "object" }
        }
      },
      "X402QuoteRequest": {
        "type": "object",
        "required": ["service_id"],
        "properties": {
          "service_id": { "type": "string", "enum": ["sandbox_execute", "web_scrape", "identity_notarize", "mcp_tool_call"] },
          "agent_did": { "type": "string" }
        }
      },
      "X402QuoteResponse": {
        "type": "object",
        "properties": {
          "invoice_id": { "type": "string" },
          "nonce": { "type": "string" },
          "amount_usd": { "type": "number" },
          "settlement_rails": { "type": "object" },
          "verify_endpoint": { "type": "string" }
        }
      },
      "X402VerifyRequest": {
        "type": "object",
        "required": ["invoice_id"],
        "properties": {
          "invoice_id": { "type": "string" },
          "transaction_hash": { "type": "string" },
          "network": { "type": "string" }
        }
      },
      "X402VerifyResponse": {
        "type": "object",
        "properties": {
          "verified": { "type": "boolean" },
          "session_token": { "type": "string" },
          "unlocked_calls_remaining": { "type": "integer" }
        }
      },
      "McpJsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "method"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
          "method": { "type": "string" },
          "params": { "type": "object" }
        }
      },
      "McpJsonRpcResponse": {
        "type": "object",
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
          "result": { "type": "object" },
          "error": { "type": "object" }
        }
      }
    }
  }
}
